{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/generated_images/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/index.js"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-ingest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/refresh-stale-ingredients",
      "schedule": "0 2 * * 0"
    }
  ]
}

