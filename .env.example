# FirstPledgePlatform environment template.
# Copy to .env and fill in real values. .env is gitignored and must NEVER be
# committed — commit efeb01b once leaked a real one into this public repo's
# permanent history (backlog E0.1). CI runs gitleaks on every PR to prevent a
# repeat; see .gitleaks.toml.

# ---------------------------------------------------------------------------
# Required — database & auth
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Full RLS-bypass access. Server-side only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Client-side (Vite) — these are baked into the browser bundle at build time,
# so only ever use the anon key here, never the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Required — AI provider
# ---------------------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-key
# Only needed when AI_PROVIDER is set to that provider:
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Required — server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Bearer fallback for admin routes when no Supabase JWT is present.
ADMIN_API_KEY=generate-a-long-random-string
# Required in production: authorizes /api/cron/* requests.
CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Analysis cache (backlog E4.11)
# ---------------------------------------------------------------------------
# Gates the ingredient_analyses cache. Leave true — setting anything other than
# "true" silently disables caching and makes every ingredient pay a fresh AI call.
USE_SUPABASE_STORAGE=true

# ---------------------------------------------------------------------------
# Optional — citation search (Google Custom Search)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_CX_ID=
GOOGLE_SEARCH_DAILY_LIMIT=100

# ---------------------------------------------------------------------------
# Optional — AI pipeline tuning
# ---------------------------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b
GROQ_COMPOUND_MODEL=groq/compound-mini
OPENAI_MODEL=
GEMINI_MODEL=
# Set to false to disable search-grounded analysis + the verification gate.
COMPOUND_RESEARCH=true
# Pacing between fresh AI calls. Groq's free tier caps at 8K tokens/minute and
# one compound call is ~4.8K tokens, so bulk runs need >= 20000 here.
AI_CALL_DELAY_MS=2000
# Opt-in: analyze all uncached ingredients of a product in a single call.
BATCH_ANALYSIS=false
# Re-analyze cached ingredient rows older than this.
INGREDIENT_REFRESH_DAYS=30

# ---------------------------------------------------------------------------
# Optional — cron tuning
# ---------------------------------------------------------------------------
# Wall-clock budget for a cron run. Production sets 280000 in vercel.json,
# under the 300s maxDuration.
CRON_BUDGET_MS=50000
CRON_PRODUCTS_PER_DAY=3
